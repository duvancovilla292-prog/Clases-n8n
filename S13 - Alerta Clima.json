      "id": "1477b501-12ac-463a-95cf-33d517a36f4b",
      "name": "HTTP Request - OpenMeteo"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "field-temp",
              "name": "temperatura",
              "value": "={{ $json.current.temperature_2m }}",
              "type": "number"
            },
            {
              "id": "field-precip",
              "name": "precipitacion",
              "value": "={{ $json.current.precipitation }}",
              "type": "number"
            },
            {
              "id": "field-code",
              "name": "codigo_clima",
              "value": "={{ $json.current.weather_code }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -464,
        128
      ],
      "id": "ec1bfd41-52e9-4b55-923a-23ef6f3b34b8",
      "name": "Resumen Clima"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-precipitacion",
              "leftValue": "={{ $json.precipitacion }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -240,
        128
      ],
      "id": "2db42167-290e-4620-9b38-1b5feb409bac",
      "name": "If: precipitacion > 0"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "msg-lluvia",
              "name": "mensaje",
              "value": "=Alerta de lluvia en Bogotá. Precipitación actual: {{ $json.precipitacion }} mm. Temperatura: {{ $json.temperatura }} °C.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
